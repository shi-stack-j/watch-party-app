# Production Environment Configuration Example
# Set NODE_ENV to production when deploying
NODE_ENV=production

# Port assigned dynamically by hosting provider (Render, Railway, Heroku, etc.)
PORT=5000

# Primary URL of your application (used for CORS configuration)
# Example: https://your-watch-party-app.onrender.com
CLIENT_URL=https://your-app.onrender.com

# Hosted MySQL Connection URL
# Example format: mysql://user:password@host:3306/database_name?sslmode=require
DATABASE_URL=mysql://db_user:db_password@db_host:3306/watchparty_db

# Cryptographically strong secret key for Express Session cookie signing
SESSION_SECRET=replace_with_a_secure_random_64_char_string

